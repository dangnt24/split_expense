rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function hasTrip(tripId) { return exists(/databases/$(database)/documents/trips/$(tripId)); }
    match /trips/{tripId} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() &&
        request.resource.data.keys().hasOnly(['name','createdBy','createdAt']) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80 &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.createdAt == request.time;
      allow update, delete: if false;
      match /members/{memberId} {
        allow read: if signedIn() && hasTrip(tripId);
        allow create: if signedIn() && hasTrip(tripId) &&
          request.resource.data.keys().hasOnly(['name']) &&
          request.resource.data.name is string &&
          request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80;
        allow update, delete: if false;
      }
      match /expenses/{expenseId} {
        allow read: if signedIn() && hasTrip(tripId);
        allow create: if signedIn() && hasTrip(tripId) &&
          request.resource.data.keys().hasOnly(['memberId','category','amount','createdBy','createdAt']) &&
          request.resource.data.memberId is string &&
          exists(/databases/$(database)/documents/trips/$(tripId)/members/$(request.resource.data.memberId)) &&
          request.resource.data.category is string && request.resource.data.category.size() <= 120 &&
          request.resource.data.amount is int && request.resource.data.amount > 0 && request.resource.data.amount <= 1000000000000 &&
          request.resource.data.createdBy == request.auth.uid &&
          request.resource.data.createdAt == request.time;
        allow update: if signedIn() && resource.data.createdBy == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['amount']) &&
          request.resource.data.amount is int && request.resource.data.amount > 0 && request.resource.data.amount <= 1000000000000;
        allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;
      }
    }
  }
}
